diff --git a/transport/internet/system_dialer_scope.go b/transport/internet/system_dialer_scope.go
new file mode 100644
--- /dev/null
+++ b/transport/internet/system_dialer_scope.go
@@ -0,0 +1,68 @@
+package internet
+
+import (
+	"context"
+	"errors"
+	"sync/atomic"
+
+	"github.com/xtls/xray-core/features/dns"
+	"github.com/xtls/xray-core/features/outbound"
+)
+
+type systemDialerScopeKey struct{}
+type systemDialerFeatures struct {
+	dns dns.Client
+	obm outbound.Manager
+}
+type systemDialerScope struct {
+	features atomic.Pointer[systemDialerFeatures]
+	retired  atomic.Bool
+}
+
+var legacySystemDialerFeatures atomic.Pointer[systemDialerFeatures]
+
+// ContextWithSystemDialerScope allocates one feature namespace per core instance.
+func ContextWithSystemDialerScope(ctx context.Context) context.Context {
+	return context.WithValue(ctx, systemDialerScopeKey{}, &systemDialerScope{})
+}
+
+// ContextWithSystemDialerScopeFrom binds caller context to the instance namespace.
+func ContextWithSystemDialerScopeFrom(ctx, owner context.Context) context.Context {
+	if scope, ok := owner.Value(systemDialerScopeKey{}).(*systemDialerScope); ok {
+		return context.WithValue(ctx, systemDialerScopeKey{}, scope)
+	}
+	return ctx
+}
+
+func InitSystemDialerContext(ctx context.Context, dc dns.Client, om outbound.Manager) error {
+	scope, ok := ctx.Value(systemDialerScopeKey{}).(*systemDialerScope)
+	if !ok || scope.retired.Load() {
+		return errors.New("missing or retired system dialer owner")
+	}
+	features := &systemDialerFeatures{dns: dc, obm: om}
+	if !scope.features.CompareAndSwap(nil, features) {
+		return errors.New("system dialer owner already initialized")
+	}
+	if scope.retired.Load() {
+		scope.features.CompareAndSwap(features, nil)
+		return errors.New("system dialer owner retired during initialization")
+	}
+	return nil
+}
+
+func RetireSystemDialerContext(ctx context.Context) {
+	if scope, ok := ctx.Value(systemDialerScopeKey{}).(*systemDialerScope); ok {
+		scope.retired.Store(true)
+		scope.features.Store(nil)
+	}
+}
+
+func systemDialerFeaturesFromContext(ctx context.Context) *systemDialerFeatures {
+	if scope, ok := ctx.Value(systemDialerScopeKey{}).(*systemDialerScope); ok {
+		if scope.retired.Load() {
+			return nil
+		}
+		return scope.features.Load() // Never borrow a process default for an empty owner.
+	}
+	return legacySystemDialerFeatures.Load()
+}
