+// Explicit legacy-server opt-out only; absent/true keep the browser hybrid share.
+func removeRealityHybridShare(conn *utls.UConn) {
+	for _, extension := range conn.Extensions {
+		switch ext := extension.(type) {
+		case *utls.SupportedCurvesExtension:
+			ext.Curves = slices.DeleteFunc(ext.Curves, func(curve utls.CurveID) bool { return curve == utls.X25519MLKEM768 })
+		case *utls.KeyShareExtension:
+			ext.KeyShares = slices.DeleteFunc(ext.KeyShares, func(share utls.KeyShare) bool { return share.Group == utls.X25519MLKEM768 })
+		}
+	}
+}
