+// Failed measurements are visible to clients but never eligible for auto-selection.
+func (s *HistoryStorage) LoadURLTestHistoryForDisplay(tag string) *adapter.URLTestHistory {
+	if s == nil {
+		return nil
+	}
+	s.access.RLock()
+	defer s.access.RUnlock()
+	if history := s.delayHistory[tag]; history != nil {
+		return history
+	}
+	return s.failureHistory[tag]
+}
+
+func (s *HistoryStorage) StoreURLTestFailure(tag string) {
+	s.access.Lock()
+	defer s.access.Unlock()
+	delete(s.delayHistory, tag)
+	s.failureHistory[tag] = &adapter.URLTestHistory{Time: time.Now()}
+	s.notifyUpdated()
+}
+
 func (s *HistoryStorage) DeleteURLTestHistory(tag string) {
 	s.access.Lock()
 	delete(s.delayHistory, tag)
+	delete(s.failureHistory, tag)
 	s.notifyUpdated()
 	s.access.Unlock()
 }
