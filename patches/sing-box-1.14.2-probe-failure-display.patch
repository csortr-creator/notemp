+package urltest
+
+import (
+	"github.com/sagernet/sing-box/adapter"
+	"testing"
+	"time"
+)
+
+func TestSFAProbeFailureDisplayCannotBecomeFastestOutbound(t *testing.T) {
+	history := NewHistoryStorage()
+	history.StoreURLTestHistory("node", &adapter.URLTestHistory{Time: time.Now(), Delay: 50})
+	history.StoreURLTestFailure("node")
+	if history.LoadURLTestHistory("node") != nil {
+		t.Fatal("failed result eligible for URLTest selection")
+	}
+	display := history.LoadURLTestHistoryForDisplay("node")
+	if display == nil || display.Time.IsZero() || display.Delay != 0 {
+		t.Fatal("failure is indistinguishable from an untested node")
+	}
+	history.StoreURLTestHistory("node", &adapter.URLTestHistory{Time: time.Now(), Delay: 70})
+	if got := history.LoadURLTestHistoryForDisplay("node"); got == nil || got.Delay != 70 {
+		t.Fatal("recovery did not replace failure")
+	}
+	history.DeleteURLTestHistory("node")
+	if history.LoadURLTestHistoryForDisplay("node") != nil {
+		t.Fatal("explicit reset kept old result")
+	}
+}
