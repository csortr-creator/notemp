+package daemon
+
+import (
+	"context"
+	"github.com/sagernet/sing-box/common/urltest"
+	"testing"
+)
+
+func TestSFAProbeSingleRPCPublishesFailureAndDoesNotPublishCancellation(t *testing.T) {
+	for _, cancelled := range []bool{false, true} {
+		outbound := &sfaProbeOutbound{entered: make(chan struct{}), release: make(chan struct{})}
+		if !cancelled {
+			close(outbound.release)
+		}
+		history := urltest.NewHistoryStorage()
+		service := &StartedService{serviceStatus: &ServiceStatus{Status: ServiceStatus_STARTED}, instance: &Instance{
+			ctx: context.Background(), outboundManager: sfaProbeManager{outbound: outbound}, urlTestHistoryStorage: history,
+		}}
+		ctx, cancel := context.WithCancel(context.Background())
+		if cancelled {
+			cancel()
+		}
+		_, err := service.URLTest(ctx, &URLTestRequest{OutboundTag: "node"})
+		cancel()
+		display := history.LoadURLTestHistoryForDisplay("node")
+		if cancelled {
+			if err == nil || display != nil {
+				t.Fatal("cancelled probe published an unavailable result")
+			}
+		} else if err == nil || display == nil || display.Time.IsZero() || display.Delay != 0 {
+			t.Fatal("failed single probe is blank")
+		}
+		if history.LoadURLTestHistory("node") != nil {
+			t.Fatal("failed probe eligible for auto-selection")
+		}
+	}
+}
