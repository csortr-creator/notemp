+package group
+
+import (
+	"context"
+	"errors"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/common/urltest"
+	"github.com/sagernet/sing-box/log"
+	M "github.com/sagernet/sing/common/metadata"
+)
+
+type sfaDisplayProbeOutbound struct {
+	adapter.Outbound
+	tag     string
+	address string
+	failure string
+	calls   atomic.Int32
+}
+
+func (o *sfaDisplayProbeOutbound) Tag() string       { return o.tag }
+func (o *sfaDisplayProbeOutbound) Network() []string { return []string{"tcp"} }
+func (o *sfaDisplayProbeOutbound) DialContext(ctx context.Context, _ string, _ M.Socksaddr) (net.Conn, error) {
+	o.calls.Add(1)
+	if o.failure == "timeout" {
+		<-ctx.Done()
+		return nil, ctx.Err()
+	}
+	if o.failure != "" {
+		return nil, errors.New(o.failure)
+	}
+	return (&net.Dialer{}).DialContext(ctx, "tcp", o.address)
+}
+
+func TestSFAProbeBatchReportsFailedNodesAndSelectsOnlySuccessfulNodes(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { time.Sleep(5 * time.Millisecond); w.WriteHeader(204) }))
+	defer server.Close()
+	good := &sfaDisplayProbeOutbound{tag: "good", address: server.Listener.Addr().String()}
+	bad := &sfaDisplayProbeOutbound{tag: "bad", failure: "fixture handshake failure"}
+	slow := &sfaDisplayProbeOutbound{tag: "slow", failure: "timeout"}
+	nodes := []adapter.Outbound{bad, slow, good}
+	history := urltest.NewHistoryStorage()
+	history.StoreURLTestHistory("bad", &adapter.URLTestHistory{Time: time.Now(), Delay: 1})
+	ctx := urltest.WithProbeTimeout(context.Background(), 100)
+	result := URLTestOutbounds(ctx, nil, history, log.NewNOPFactory().Logger(), nodes, server.URL, 0, true)
+	if len(result) != 1 || result["good"] == 0 {
+		t.Fatalf("unexpected successful results: %v", result)
+	}
+	for _, node := range []*sfaDisplayProbeOutbound{good, bad, slow} {
+		if node.calls.Load() != 1 {
+			t.Fatalf("node %s was skipped or tested twice", node.tag)
+		}
+		display := history.LoadURLTestHistoryForDisplay(node.tag)
+		if display == nil || display.Time.IsZero() {
+			t.Fatalf("node %s has a blank result", node.tag)
+		}
+	}
+	group := &URLTestGroup{history: history, outbounds: nodes, selectedOutboundTCP: bad}
+	selected, _ := group.Select("tcp")
+	if selected == nil || selected.Tag() != "good" {
+		t.Fatal("failed low-latency node won auto-selection")
+	}
+}
