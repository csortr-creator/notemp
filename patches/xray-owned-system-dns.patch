+// LookupIPContext resolves through an installed owner callback before any OS DNS.
+func (c *Client) LookupIPContext(ctx context.Context, host string, option dns.IPOption) ([]net.IP, uint32, error) {
+	var ips []net.IP
+	var err error
+	if internet.HasSystemDomainResolver() {
+		ips, err = internet.ResolveSystemDomain(ctx, host)
+	} else if len(internet.Controllers) > 0 {
+		ips, err = c.r.LookupIP(ctx, "ip", host)
+	} else {
+		ips, err = net.DefaultResolver.LookupIP(ctx, "ip", host)
+	}
+	if err != nil {
+		return nil, 0, err
+	}
+	return filterIPs(ips, option)
+}
+
+func filterIPs(ips []net.IP, option dns.IPOption) ([]net.IP, uint32, error) {
