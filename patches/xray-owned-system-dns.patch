diff --git a/transport/internet/system_dns.go b/transport/internet/system_dns.go
new file mode 100644
--- /dev/null
+++ b/transport/internet/system_dns.go
@@ -0,0 +1,35 @@
+package internet
+
+import (
+	"context"
+	"github.com/xtls/xray-core/common/net"
+)
+
+// SystemDomainResolver must fail closed for missing/retired network owners.
+type SystemDomainResolver interface {
+	ResolveSystemDomain(context.Context, string) ([]net.IP, error)
+}
+type DirectSystemDNSGuard interface{ CheckDirectSystemDNS(context.Context) error }
+
+func HasSystemDomainResolver() bool {
+	_, ok := effectiveSystemDialer.(SystemDomainResolver)
+	return ok
+}
+
+func ResolveSystemDomain(ctx context.Context, domain string) ([]net.IP, error) {
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	if resolver, ok := effectiveSystemDialer.(SystemDomainResolver); ok {
+		return resolver.ResolveSystemDomain(ctx, domain)
+	}
+	return net.DefaultResolver.LookupIP(ctx, "ip", domain)
+}
+
+// Direct DNS transports and SRV/TXT need more than the A/AAAA owner callback.
+func CheckDirectSystemDNS(ctx context.Context) error {
+	if guard, ok := effectiveSystemDialer.(DirectSystemDNSGuard); ok {
+		return guard.CheckDirectSystemDNS(ctx)
+	}
+	return ctx.Err()
+}
