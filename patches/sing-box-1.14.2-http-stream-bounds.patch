+func (h *httpResponse) copyBody(writer io.Writer) error {
+	var reader io.Reader = h.Body
+	if h.responseLimit > 0 {
+		if h.ContentLength > h.responseLimit {
+			return E.New("HTTP_RESPONSE_TOO_LARGE")
+		}
+		reader = io.LimitReader(h.Body, h.responseLimit+1)
+	}
+	written, err := bufio.Copy(writer, reader)
+	if err != nil {
+		return err
+	}
+	if h.responseLimit > 0 && written > h.responseLimit {
+		return E.New("HTTP_RESPONSE_TOO_LARGE")
+	}
