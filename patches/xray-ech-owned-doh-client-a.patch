--- /dev/null
+++ b/transport/internet/tls/ech_doh_owner_test.go
@@ -0,0 +1,15 @@
+package tls
+
+import (
+	"io"
+	"net/http"
+	"testing"
+)
+
+func TestDOHHTTPClientCloseIdle(t *testing.T) {
+	d := &dohHTTPClient{client: &http.Client{Transport: &http.Transport{}}}
+	if err := d.Close(); err != nil {
+		t.Fatal(err)
+	}
+	var _ io.Closer = (*dohHTTPClient)(nil)
+}
