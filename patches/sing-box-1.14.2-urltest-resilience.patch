@@ -0,0 +1,96 @@
+package urltest
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net"
+	"time"
+
+	N "github.com/sagernet/sing/common/network"
+)
+
+type candidateResult struct {
+	delay uint16
+	err   error
+}
+
+// Keep the primary's full timeout. After half the shared budget, a second
+// origin may test an already dialled tunnel. Both attempts use the same outbound.
+// Explicit profile URLs never enter this path; no protocol settings are changed.
+func urlTestCandidates(parent context.Context, links []string, detour N.Dialer, warm bool) (uint16, error) {
+	ctx, cancel := context.WithCancel(parent)
+	defer cancel()
+	results := make(chan candidateResult, 2)
+	connected := make(chan struct{})
+	go func() {
+		d, e := urlTestAttempt(ctx, links[0], detour, warm, func() { close(connected) })
+		results <- candidateResult{d, e}
+	}()
+	budget := ProbeTimeout(ctx)
+	if deadline, ok := ctx.Deadline(); ok {
+		budget = time.Until(deadline)
+	}
+	timer := time.NewTimer(max(budget/2, time.Millisecond))
+	defer timer.Stop()
+	var primaryErr error
+	held, fallback := false, false
+	launchFallback := func() {
+		fallback = true
+		go func() { d, e := urlTestAttempt(ctx, links[1], detour, warm, nil); results <- candidateResult{d, e} }()
+	}
+	for {
+		select {
+		case result := <-results:
+			if result.err == nil {
+				return max(result.delay, 1), nil
+			}
+			if !fallback {
+				if !retryableOriginFailure(result.err) {
+					return 0, result.err
+				}
+				primaryErr = result.err
+				launchFallback()
+			} else if primaryErr != nil {
+				return 0, primaryErr
+			} else {
+				primaryErr = result.err
+			}
+		case <-timer.C:
+			held = true
+			if connected == nil && !fallback {
+				launchFallback()
+			}
+		case <-connected:
+			connected = nil
+			if held && !fallback {
+				launchFallback()
+			}
+		case <-ctx.Done():
+			if primaryErr != nil && parent.Err() == nil {
+				return 0, primaryErr
+			}
+			stage := "connect"
+			if connected == nil {
+				stage = "tunnel-or-origin"
+			} else {
+				select {
+				case <-connected:
+					stage = "tunnel-or-origin"
+				default:
+				}
+			}
+			return 0, &ProbeError{Stage: stage, Err: ctx.Err()}
+		}
+	}
+}
+
+func retryableOriginFailure(err error) bool {
+	var phase *ProbeError
+	if !errors.As(err, &phase) || phase.Stage == "connect" {
+		return false
+	}
+	var networkError net.Error
+	return errors.Is(err, io.EOF) || errors.Is(err, io.ErrUnexpectedEOF) ||
+		(errors.As(err, &networkError) && networkError.Timeout())
+}
