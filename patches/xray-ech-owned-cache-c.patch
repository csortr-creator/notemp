new file mode 100644
--- /dev/null
+++ b/transport/internet/tls/ech_owner_test.go
@@ -0,0 +1,26 @@
+package tls
+
+import (
+	"context"
+	"io"
+	"testing"
+)
+
+func TestECHConfigCacheCloseRejectsUpdate(t *testing.T) {
+	c := &ECHConfigCache{}
+	c.configRecord.Store(&echConfigRecord{})
+	if err := c.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := c.Update(context.Background(), "example.com", "https://1.1.1.1/dns-query", false, nil); err == nil {
+		t.Fatal("expected retired error")
+	}
+	var _ io.Closer = (*ECHConfigCache)(nil)
+}
+
+func TestQueryRecordOwnedPathUsesScope(t *testing.T) {
+	// Without a system-dialer scope, QueryRecord uses the global map (legacy).
+	// Smoke: does not panic with background context.
+	_, err := QueryRecord(context.Background(), "invalid.invalid", "udp://127.0.0.1:1", nil)
+	_ = err
+}
