+// Close retires the manager and closes all clients outside the lock.
+func (m *XmuxManager) Close() error {
+	m.mu.Lock()
+	if m.retired {
+		m.mu.Unlock()
+		return nil
+	}
+	m.retired = true
+	clients := m.xmuxClients
+	m.xmuxClients = nil
+	m.mu.Unlock()
+	for _, xmuxClient := range clients {
+		xmuxClient.NotUsed.Store(true)
+		common.Close(xmuxClient.XmuxConn)
+	}
+	return nil
+}
