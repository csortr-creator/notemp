diff --git a/transport/internet/system_dialer_resources.go b/transport/internet/system_dialer_resources.go
new file mode 100644
--- /dev/null
+++ b/transport/internet/system_dialer_resources.go
@@ -0,0 +1,104 @@
+package internet
+
+import (
+	"context"
+	"errors"
+	"io"
+)
+
+var errSystemDialerRetired = errors.New("system dialer resource owner retired")
+
+// AcquireSystemDialerResource caches only within the instance scope. Factories
+// and Close callbacks run outside the lock and may reenter owner operations.
+// The bool distinguishes an explicit owner from legacy unscoped callers.
+func AcquireSystemDialerResource(ctx context.Context, key any, create func() (io.Closer, error)) (io.Closer, bool, error) {
+	scope, owned := ctx.Value(systemDialerScopeKey{}).(*systemDialerScope)
+	if !owned {
+		return nil, false, nil
+	}
+	scope.resourcesMu.Lock()
+	if scope.retired.Load() || ctx.Err() != nil {
+		scope.resourcesMu.Unlock()
+		if ctx.Err() != nil {
+			return nil, true, ctx.Err()
+		}
+		return nil, true, errSystemDialerRetired
+	}
+	resource := scope.resources[key]
+	scope.resourcesMu.Unlock()
+	if resource != nil {
+		return resource, true, nil
+	}
+	candidate, err := create()
+	if err != nil {
+		if candidate != nil {
+			_ = candidate.Close()
+		}
+		return nil, true, err
+	}
+	if candidate == nil {
+		return nil, true, errors.New("nil system dialer resource")
+	}
+	scope.resourcesMu.Lock()
+	if scope.retired.Load() || ctx.Err() != nil {
+		scope.resourcesMu.Unlock()
+		_ = candidate.Close()
+		if ctx.Err() != nil {
+			return nil, true, ctx.Err()
+		}
+		return nil, true, errSystemDialerRetired
+	}
+	winner := scope.resources[key]
+	if winner == nil {
+		scope.resources[key] = candidate
+	}
+	scope.resourcesMu.Unlock()
+	if winner != nil {
+		_ = candidate.Close()
+		return winner, true, nil
+	}
+	return candidate, true, nil
+}
+
+type systemDialerOperationContext struct {
+	context.Context
+	owner context.Context
+}
+
+func (c systemDialerOperationContext) Value(key any) any {
+	// Preserve operation internals (notably context.Cause's cancellation key).
+	// Bind the feature scope explicitly; other instance-base values are fallback
+	// values for gRPC's fresh, otherwise unowned operation context.
+	if _, scopeKey := key.(systemDialerScopeKey); scopeKey {
+		return c.owner.Value(key)
+	}
+	if value := c.Context.Value(key); value != nil {
+		return value
+	}
+	return c.owner.Value(key)
+}
+
+// A cached transport must use its instance base values, never the first
+// request's values/cancellation. Preserve the operation deadline/cancellation,
+// and additionally cancel pending work when the instance retires.
+func ContextWithSystemDialerOwner(operation, caller context.Context) (context.Context, context.CancelFunc) {
+	scope, owned := caller.Value(systemDialerScopeKey{}).(*systemDialerScope)
+	if !owned {
+		return operation, func() {}
+	}
+	ctx, cancel := context.WithCancel(operation)
+	stop := context.AfterFunc(scope.owner, cancel)
+	if scope.owner.Err() != nil {
+		cancel()
+	}
+	return systemDialerOperationContext{Context: ctx, owner: scope.owner}, func() { stop(); cancel() }
+}
+
+// SystemDialerOwnerBase drops request values/cancellation for retained transports.
+// Legacy callers retain their pre-existing context behavior.
+func SystemDialerOwnerBase(ctx context.Context) context.Context {
+	if scope, ok := ctx.Value(systemDialerScopeKey{}).(*systemDialerScope); ok {
+		return scope.owner
+	}
+	return ctx
+}
